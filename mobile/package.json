{
  "name": "gymfinder-mobile",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "assets:generate": "node scripts/generate-assets.cjs",
    "release:check": "node scripts/verify-release.cjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/native": "^7.5.1",
    "expo": "~58.0.19",
    "expo-file-system": "~58.0.11",
    "expo-image-picker": "~58.0.10",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "clearMocks": true,
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ]
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.3.0",
    "eas-cli": "^25.3.0",
    "jest": "^30.5.2",
    "jest-expo": "^58.0.12",
    "react-test-renderer": "^19.3.0",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2"
  }
