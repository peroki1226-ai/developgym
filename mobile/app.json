{
  "expo": {
    "name": "GymFinder",
    "slug": "gymfinder",
    "version": "1.0.0",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.peroki.gymfinder",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.peroki.gymfinder",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-foreground.png",
        "monochromeImage": "./assets/adaptive-foreground.png",
        "backgroundColor": "#000000"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "permissions": ["android.permission.CAMERA"]
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "cameraPermission": "GymFinderで設備写真を撮影するためにカメラを使用します。",
          "photosPermission": "GymFinderで設備写真を選ぶために写真を使用します。",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/splash.png",
          "imageWidth": 240,
          "resizeMode": "contain"
        }
      ]
    ],
    "description": "希望する種目と設備からジムを探し、ジム・家トレ・食事を記録するフィットネスアプリ。",
    "icon": "./assets/icon.png",
    "backgroundColor": "#000000"
  }
}
