{
  "expo": {
    "name": "GymFinder",
    "slug": "gymfinder",
    "version": "1.0.0",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gymfinder.mobile",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.gymfinder.mobile"
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "cameraPermission": "GymFinderで設備写真を撮影するためにカメラを使用します。",
          "photosPermission": "GymFinderで設備写真を選ぶために写真を使用します。",
          "microphonePermission": false
        }
      ]
    ]
  }
}
