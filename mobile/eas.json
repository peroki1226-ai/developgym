{
  "cli": {
    "version": ">= 25.3.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "node": "24.19.0",
      "autoIncrement": false,
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      },
      "credentialsSource": "remote"
    },
    "production": {
      "distribution": "store",
      "node": "24.19.0",
      "autoIncrement": false,
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "app-bundle"
      },
      "credentialsSource": "remote"
    }
  }
}
